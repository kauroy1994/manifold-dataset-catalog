{
  "@context": {
    "@version": 1.1,
    "peg": "https://example.org/manifold/peg#",
    "schema": "https://schema.org/",
    "prov": "http://www.w3.org/ns/prov#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "id": "@id",
    "type": "@type",
    "name": "schema:name",
    "description": "schema:description",
    "sourceDataset": {
      "@id": "peg:sourceDataset",
      "@type": "@id"
    },
    "expectedProcedure": {
      "@id": "peg:expectedProcedure",
      "@type": "@id"
    },
    "execution": {
      "@id": "peg:execution",
      "@type": "@id"
    },
    "fromState": {
      "@id": "peg:fromState",
      "@type": "@id"
    },
    "toState": {
      "@id": "peg:toState",
      "@type": "@id"
    },
    "requiredOperation": {
      "@id": "peg:requiredOperation",
      "@type": "@id"
    },
    "evidence": {
      "@id": "peg:evidence",
      "@type": "@id"
    },
    "component": {
      "@id": "peg:component",
      "@type": "@id"
    },
    "hasState": {
      "@id": "peg:hasState",
      "@type": "@id"
    },
    "hasOperation": {
      "@id": "peg:hasOperation",
      "@type": "@id"
    },
    "hasDeviation": {
      "@id": "peg:hasDeviation",
      "@type": "@id"
    },
    "operationType": "peg:operationType",
    "executionStatus": "peg:executionStatus",
    "assemblyStatus": "peg:assemblyStatus",
    "componentPresence": "peg:componentPresence",
    "confidence": {
      "@id": "peg:confidence",
      "@type": "xsd:decimal"
    },
    "startTime": {
      "@id": "peg:startTime",
      "@type": "xsd:decimal"
    },
    "endTime": {
      "@id": "peg:endTime",
      "@type": "xsd:decimal"
    },
    "sourceCycleId": "peg:sourceCycleId",
    "defectLabel": "peg:defectLabel",
    "assertionStatus": "peg:assertionStatus"
  },
  "@id": "peg:example-future-factories-v1",
  "@type": "peg:ProcessEventGraphExample",
  "name": "Illustrative MANIFOLD Process Event Graph — not a verified execution",
  "description": "Hand-authored conceptual model based on the project-supplied example and the published NoNoseCone defect category. No source cycle, raw observation, timestamp, confidence score, or operation outcome has been verified. The example.org namespace is illustrative.",
  "@graph": [
    {
      "@id": "peg:future-factories-v1",
      "@type": "schema:Dataset",
      "name": "Future Factories V1",
      "description": "Source dataset family described by Harik et al. (2024), arXiv:2401.15544. This example is not linked to downloaded source records."
    },
    {
      "@id": "peg:rocket-assembly-procedure",
      "@type": "peg:ExpectedProcedure",
      "name": "Rocket assembly (schematic expected procedure)",
      "sourceDataset": "peg:future-factories-v1",
      "assertionStatus": "illustrative_not_verified",
      "hasState": [
        "peg:expected-body-ready",
        "peg:expected-complete"
      ],
      "hasOperation": [
        "peg:expected-install-nose-cone"
      ]
    },
    {
      "@id": "peg:expected-body-ready",
      "@type": "peg:ManufacturingState",
      "name": "Body assembled; nose cone not yet installed",
      "assemblyStatus": "in_progress",
      "assertionStatus": "illustrative_not_verified"
    },
    {
      "@id": "peg:expected-complete",
      "@type": "peg:ManufacturingState",
      "name": "Complete rocket",
      "assemblyStatus": "complete",
      "assertionStatus": "illustrative_not_verified"
    },
    {
      "@id": "peg:expected-install-nose-cone",
      "@type": "peg:ExpectedOperation",
      "name": "Install nose cone",
      "operationType": "install_component",
      "component": "peg:nose-cone",
      "fromState": "peg:expected-body-ready",
      "toState": "peg:expected-complete",
      "assertionStatus": "illustrative_not_verified"
    },
    {
      "@id": "peg:nose-cone",
      "@type": "peg:Component",
      "name": "Nose cone"
    },
    {
      "@id": "peg:example-defective-execution",
      "@type": "peg:ManufacturingExecution",
      "name": "Illustrative NoNoseCone execution",
      "sourceDataset": "peg:future-factories-v1",
      "expectedProcedure": "peg:rocket-assembly-procedure",
      "defectLabel": "NoNoseCone",
      "sourceCycleId": null,
      "hasState": [
        "peg:observed-final-incomplete"
      ],
      "hasDeviation": [
        "peg:missing-nose-cone-deviation"
      ],
      "assertionStatus": "illustrative_not_verified"
    },
    {
      "@id": "peg:observed-final-incomplete",
      "@type": "peg:ManufacturingState",
      "name": "Rocket without nose cone",
      "assemblyStatus": "incomplete",
      "componentPresence": "nose_cone_absent",
      "evidence": [
        "peg:cycle-level-defect-annotation"
      ],
      "assertionStatus": "inferred_from_defect_category_not_verified_for_specific_cycle"
    },
    {
      "@id": "peg:missing-nose-cone-deviation",
      "@type": "peg:ProcedureDeviation",
      "name": "Expected nose-cone installation not established in execution",
      "requiredOperation": "peg:expected-install-nose-cone",
      "execution": "peg:example-defective-execution",
      "executionStatus": "not_observed_or_not_established",
      "description": "Do not interpret this as proof that an installation was attempted, failed, or explicitly skipped. Those statuses require operation-level evidence.",
      "evidence": [
        "peg:cycle-level-defect-annotation"
      ],
      "assertionStatus": "hypothesis_requiring_trace_validation"
    },
    {
      "@id": "peg:cycle-level-defect-annotation",
      "@type": "peg:EvidenceRecord",
      "name": "Illustrative NoNoseCone category reference",
      "defectLabel": "NoNoseCone",
      "sourceDataset": "peg:future-factories-v1",
      "sourceCycleId": null,
      "description": "Placeholder for a future verified annotation reference. No real source cycle is selected. This is not a raw annotation record and does not establish when or whether an operation occurred.",
      "assertionStatus": "illustrative_placeholder_not_source_evidence"
    }
  ]
}
